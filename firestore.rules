rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Custom claim "role" is set when the server mints the Firebase
      // custom token during the Discord OAuth callback (see route.ts).
      return isSignedIn() && request.auth.token.role == "admin";
    }

    function isGuildMember() {
      return isSignedIn() && request.auth.token.guildMember == true;
    }

    function isValidTransaction() {
      return request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.kind in ["deposit", "withdraw"]
        && request.resource.data.targetType in ["money", "item"]
        && request.resource.data.targetKey is string
        && request.resource.data.targetKey != ""
        && (request.resource.data.targetType != "money"
          || request.resource.data.targetKey in ["cash", "redMoney"]);
    }

    // Member profiles — written only by the server (Admin SDK) during login.
    match /users/{uid} {
      allow read: if isGuildMember();
      allow write: if false;
    }

    // Gang balances — written only by the server, inside an atomic
    // transaction, when an admin approves a request.
    match /treasury/{docId} {
      allow read: if isGuildMember();
      allow write: if false;
    }

    // Item catalog / quantities.
    match /inventory/{itemId} {
      allow read: if isGuildMember();
      // Admins may add new item types to the catalog directly (quantity
      // should start at 0); quantity changes on existing items only ever
      // happen through the server-side approve API.
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // Deposit/withdraw requests.
    match /transactions/{txId} {
      allow read: if isGuildMember();
      // Members may only create their own, always starting as "pending".
      allow create: if isGuildMember()
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == "pending"
                    && isValidTransaction();
      // Approving/rejecting is only done server-side with the Admin SDK,
      // which bypasses these rules entirely.
      allow update: if false;
      allow delete: if false;
    }
  }
}
