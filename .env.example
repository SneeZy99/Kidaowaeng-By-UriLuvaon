# ── Firebase — Client SDK (public, safe to expose in browser) ──────────────
# Firebase Console → Project settings → General → "Your apps" → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase — Admin SDK (SECRET, server-only, never expose to the browser) ─
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the whole private_key value from the downloaded JSON, keep the \n escape sequences as-is
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"

# ── Discord OAuth2 ───────────────────────────────────────────────────────────
# Discord Developer Portal → Your App → OAuth2 → Client information
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a "Redirect" URL registered in the Discord app's OAuth2 tab
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord

# ── Gang admin allow-list ────────────────────────────────────────────────────
# Comma-separated Discord user IDs (numeric "Discord ID", not username) that
# should be treated as gang leaders / admins. Right click a user in Discord
# with Developer Mode enabled → "Copy User ID".
ADMIN_DISCORD_IDS=123456789012345678,234567890123456789
